{
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/*.astro",
    "**/*.md",
    "**/*.mdx",
    "dist/**",
    "vendor/**",
    "src/components/ui/**"
  ],
  "sortImports": true,
  "sortPackageJson": false
}
